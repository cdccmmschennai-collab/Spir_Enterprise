# Application
APP_NAME="SPIR Dynamic Extraction"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO

# File handling
MAX_FILE_SIZE_MB=2048
PREVIEW_ROW_COUNT=12

# CORS — must list exact frontend origin (no wildcard) when allow_credentials=True
ALLOWED_ORIGINS=["http://localhost:3000"]

# Auth
APP_USER=admin
APP_PASS=admin123
# Generate with: openssl rand -hex 32
SECRET_KEY=mysecretkey123456
TOKEN_EXPIRE_HOURS=8

# Object storage — MinIO (Docker Compose stack, Phase 3A: infrastructure only).
# Compose reads these from the repo-root .env to set the MinIO root credentials
# and to pass matching MINIO_ACCESS_KEY / MINIO_SECRET_KEY to the API/workers.
# Placeholders only — never commit real credentials. Password must be >= 8 chars.
MINIO_ROOT_USER=spir_minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=spir-files
# Native (non-Docker) runs: leave MINIO_ENDPOINT unset unless
# UPLOAD_STORAGE_BACKEND=minio below. Inside Docker the endpoint is http://minio:9000.
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=spir_minio
# MINIO_SECRET_KEY=change-me-minio-password
# MINIO_SECURE=false

# Storage backend behind spir_dynamic.services.object_storage (Phase 3B).
# "filesystem" (default) keeps every area on the local storage/ tree;
# "minio" selects the S3 backend and requires the MINIO_* settings above.
STORAGE_BACKEND=filesystem
# Phase 3C — backend for the source uploads handed to the Celery workers
# (large single files and every batch file) ONLY. Empty = same as
# STORAGE_BACKEND. "minio" stores them in the bucket under batch_uploads/ and
# workers download each one to a temp file before extraction.
# UPLOAD_STORAGE_BACKEND=minio
# Where a worker keeps that temp download (default: system temp directory).
# WORKER_SCRATCH_DIR=/var/tmp/spir

# Phase 3D — direct browser-to-MinIO upload for large files (> LARGE_FILE_THRESHOLD_MB).
# The API only signs URLs; the browser PUTs the parts to MinIO itself.
# Prerequisites: UPLOAD_STORAGE_BACKEND=minio and CELERY_ENABLED=true.
#
# 1. MINIO_PUBLIC_ENDPOINT — the address the BROWSER reaches MinIO at. Never a
#    Docker service name (MINIO_ENDPOINT=http://minio:9000 stays container-only).
#    Empty = direct upload off, every upload keeps the API-streamed path.
#    Compose default: http://localhost:9000. Production: the HTTPS host in front
#    of MinIO (Nginx must forward the Host header unchanged).
# MINIO_PUBLIC_ENDPOINT=https://files.your-domain.com
#
# 2. Scoped signing user. minio-init creates MINIO_UPLOADER_USER with policy
#    "spir-uploader" (PutObject on batch_uploads/* only) and the API signs the
#    browser's part URLs with MINIO_PRESIGN_ACCESS_KEY / _SECRET_KEY, so the root
#    key id never appears in a URL. Leave the PRESIGN pair empty to sign with the
#    main MINIO_ACCESS_KEY / MINIO_SECRET_KEY instead.
# MINIO_UPLOADER_USER=spir_uploader
# MINIO_UPLOADER_PASSWORD=change-me-uploader-password
# MINIO_PRESIGN_ACCESS_KEY=spir_uploader
# MINIO_PRESIGN_SECRET_KEY=change-me-uploader-password
#
# 3. CORS — the browser origin(s) MinIO answers for (Compose maps this to
#    MINIO_API_CORS_ALLOW_ORIGIN; comma-separated for several).
# MINIO_CORS_ALLOW_ORIGIN=https://your-domain.com
#
# 4. Tuning (defaults shown).
# DIRECT_UPLOAD_ENABLED=true          # kill switch
# DIRECT_UPLOAD_PART_SIZE_MB=16       # >= 5 (S3 minimum part size)
# DIRECT_UPLOAD_URL_TTL_SECONDS=3600  # per-part URL lifetime; the browser re-signs expired ones

# Avatar images directory (CWD-relative by default, unchanged from before).
# AVATAR_DIR=storage/avatars
