# Application
APP_NAME="SPIR Dynamic Extraction"
APP_VERSION="0.1.0"
DEBUG=false
LOG_LEVEL=INFO

# File handling
MAX_FILE_SIZE_MB=2048
PREVIEW_ROW_COUNT=12

# CORS — must list exact frontend origin (no wildcard) when allow_credentials=True
ALLOWED_ORIGINS=["http://localhost:3000"]

# Auth
APP_USER=admin
APP_PASS=admin123
# Generate with: openssl rand -hex 32
SECRET_KEY=mysecretkey123456
TOKEN_EXPIRE_HOURS=8

# Object storage — MinIO (Docker Compose stack, Phase 3A: infrastructure only).
# Compose reads these from the repo-root .env to set the MinIO root credentials
# and to pass matching MINIO_ACCESS_KEY / MINIO_SECRET_KEY to the API/workers.
# Placeholders only — never commit real credentials. Password must be >= 8 chars.
MINIO_ROOT_USER=spir_minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=spir-files
# Native (non-Docker) runs: leave MINIO_ENDPOINT unset unless
# UPLOAD_STORAGE_BACKEND=minio below. Inside Docker the endpoint is http://minio:9000.
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=spir_minio
# MINIO_SECRET_KEY=change-me-minio-password
# MINIO_SECURE=false
#
# Server-side identity (deploy/minio/README.md). Signs every call the API, the
# Celery workers and the lifecycle cleanup make themselves — including the
# DeleteObject that removes a source object once its extraction succeeded.
# minio-init / deploy/minio/provision-identities.sh create MINIO_BACKEND_USER
# with policy "spir-backend": Get/Put/Delete + multipart on batch_uploads/* and
# a prefix-fenced ListBucket, nothing else. Leave empty to fall back to
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY (single-identity mode).
# NEVER point this at the uploader identity below: it cannot delete, and every
# source object would then stay in the bucket forever.
# MINIO_BACKEND_USER=spir_backend
# MINIO_BACKEND_PASSWORD=change-me-backend-password
# MINIO_BACKEND_ACCESS_KEY=spir_backend
# MINIO_BACKEND_SECRET_KEY=change-me-backend-password

# Storage backend behind spir_dynamic.services.object_storage (Phase 3B).
# "filesystem" (default) keeps every area on the local storage/ tree;
# "minio" selects the S3 backend and requires the MINIO_* settings above.
STORAGE_BACKEND=filesystem
# Phase 3C — backend for the source uploads handed to the Celery workers
# (large single files and every batch file) ONLY. Empty = same as
# STORAGE_BACKEND. "minio" stores them in the bucket under batch_uploads/ and
# workers download each one to a temp file before extraction.
# UPLOAD_STORAGE_BACKEND=minio
# Where a worker keeps that temp download (default: system temp directory).
# WORKER_SCRATCH_DIR=/var/tmp/spir

# Phase 3D — direct browser-to-MinIO upload for large files (> LARGE_FILE_THRESHOLD_MB).
# The API only signs URLs; the browser PUTs the parts to MinIO itself.
# Prerequisites: UPLOAD_STORAGE_BACKEND=minio and CELERY_ENABLED=true.
#
# 1. MINIO_PUBLIC_ENDPOINT — the address the BROWSER reaches MinIO at. Never a
#    Docker service name (MINIO_ENDPOINT=http://minio:9000 stays container-only).
#    Empty = direct upload off, every upload keeps the API-streamed path.
#    Compose default: http://localhost:9000. Production: the HTTPS host in front
#    of MinIO (Nginx must forward the Host header unchanged).
# MINIO_PUBLIC_ENDPOINT=https://files.your-domain.com
#
# 2. Scoped signing user. minio-init creates MINIO_UPLOADER_USER with policy
#    "spir-uploader" (PutObject on batch_uploads/* only — explicitly NO
#    DeleteObject, NO GetObject, NO ListBucket) and the API signs the browser's
#    part URLs with MINIO_PRESIGN_ACCESS_KEY / _SECRET_KEY, so the root key id
#    never appears in a URL. Leave the PRESIGN pair empty to sign with the main
#    MINIO_ACCESS_KEY / MINIO_SECRET_KEY instead — but once
#    MINIO_BACKEND_ACCESS_KEY is set, these become required: the backend refuses
#    to sign browser URLs with the delete-capable server identity.
# MINIO_UPLOADER_USER=spir_uploader
# MINIO_UPLOADER_PASSWORD=change-me-uploader-password
# MINIO_PRESIGN_ACCESS_KEY=spir_uploader
# MINIO_PRESIGN_SECRET_KEY=change-me-uploader-password
#
# 3. CORS — the browser origin(s) MinIO answers for (Compose maps this to
#    MINIO_API_CORS_ALLOW_ORIGIN; comma-separated for several).
# MINIO_CORS_ALLOW_ORIGIN=https://your-domain.com
#
# 4. Tuning (defaults shown).
# DIRECT_UPLOAD_ENABLED=true          # kill switch
# DIRECT_UPLOAD_PART_SIZE_MB=16       # >= 5 (S3 minimum part size)
# DIRECT_UPLOAD_URL_TTL_SECONDS=3600  # per-part URL lifetime; the browser re-signs expired ones

# Avatar images directory (CWD-relative by default, unchanged from before).
# AVATAR_DIR=storage/avatars

# Storage lifecycle cleanup (Celery Beat, 02:00 UTC — spir_dynamic.tasks.lifecycle_cleanup).
# CLEANUP_JSON_RETENTION_DAYS=14
# Source objects / staging files older than this are treated as orphans left by
# a crashed worker and deleted. The extraction task already deletes its own
# source immediately on success, so this only ever catches stragglers.
# CLEANUP_UPLOAD_STALE_HOURS=24
# true = log what would be deleted, delete nothing. Use it for the first run on
# a new deployment, then set it to false — a permanent true means orphaned
# source objects accumulate in the bucket forever. PRODUCTION: false.
CLEANUP_DRY_RUN=false
# Queue Beat publishes the cleanup to. It MUST be one a running worker consumes
# (the deployed workers read normal,heavy and giant). Celery's default "celery"
# queue is read by no one, which is why this is routed explicitly.
# CLEANUP_QUEUE=normal

# Currency conversion (UNIT PRICE -> UNIT PRICE (QAR)). Daily rates come from
# the free Frankfurter API — no key, no quota. Rates are fetched once per
# processing job, frozen for that job, and stored with the extraction history
# (extraction_history.currency_rates) so every file keeps the rate it used.
# Fallback chain when the API is unreachable / times out / returns 5xx:
#   live API -> last successful rate persisted in Redis (REDIS_URL, shared by
#   API + workers, never expires) -> static table in currency_service.py.
# Each snapshot entry records source = live | cached | fallback and why. Only
# when nothing in the chain has a rate does the job fail (clear error) —
# QAR cells are never left blank because of an outage.
# CURRENCY_API_BASE_URL=https://api.frankfurter.dev
# CURRENCY_API_TIMEOUT_SECONDS=10
# CURRENCY_RATE_CACHE_TTL_SECONDS=3600   # in-process reuse of a fetched daily quote; 0 = off
