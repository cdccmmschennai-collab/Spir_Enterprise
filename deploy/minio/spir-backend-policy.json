{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SourceObjectLifecycle",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::spir-files/batch_uploads/*"
      ]
    },
    {
      "Sid": "ListSourceAreaOnly",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::spir-files"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "batch_uploads/*",
            "batch_uploads/"
          ]
        }
      }
    }
  ]
}
